# Carpeta local donde clonaste el repo de datos (privado)
#   git clone https://github.com/LucumaAgency/video-review-proyectos.git
DATA_REPO=C:\video-review-proyectos

# Puerto del dashboard local
PORT=5180

# Binarios. Deja el nombre a secas si estan en el PATH.
FFMPEG=ffmpeg
FFPROBE=ffprobe
PYTHON=python

# Whisper
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_LANG=es

# Ingest
FRAME_CADA=10
FRAME_ANCHO=640
SILENCIO_DB=-32
SILENCIO_MIN=0.35
