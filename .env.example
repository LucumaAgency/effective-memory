# Carpeta local donde clonaste el repo de datos (privado)
#   git clone https://github.com/LucumaAgency/video-review-proyectos.git
DATA_REPO=C:\video-review-proyectos

# Puerto del dashboard local
PORT=5180

# Carpeta con los videos de esta maquina. Si un proyecto se creo en otro equipo,
# meta.json trae la ruta de ese equipo; aqui se busca el mismo nombre de archivo.
# Asi el mismo proyecto se abre en dos PCs sin editar nada.
VIDEOS_DIR=

# Binarios. Deja el nombre a secas si estan en el PATH.
FFMPEG=ffmpeg
FFPROBE=ffprobe
PYTHON=python

# Navegador para los motion graficos. Vacio = se busca Chrome y luego Edge.
NAVEGADOR=

# Whisper
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_LANG=es

# Ingest
FRAME_CADA=10
FRAME_ANCHO=640
SILENCIO_DB=-32
SILENCIO_MIN=0.35
